{
  "name": "reverse-proxy-middleware",
  "version": "0.0.149",
  "description": "A reverse proxy blocking bot requests.",
  "keywords": [
    "api",
    "backend",
    "bot-blocker",
    "middleware",
    "proxy",
    "reverse-proxy",
    "web"
  ],
  "homepage": "https://tsickert.com/reverse-proxy-middleware",
  "bugs": {
    "email": "info@tsickert.com",
    "url": "https://github.com/thaibault/reverse-proxy-middleware/issues"
  },
  "license": "CC-BY-4.0",
  "author": {
    "email": "info@tsickert.com",
    "name": "Torben Sickert",
    "url": "https://tsickert.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thaibault/reverse-proxy-middleware.git"
  },
  "type": "module",
  "imports": {
    "*": "/application/node_modules/*"
  },
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "yarn build:types && yarn build:plain",
    "build:plain": "weboptimizer build",
    "build:types": "weboptimizer build:types",
    "check": "yarn check:types && yarn lint",
    "check:types": "weboptimizer check:types",
    "clear": "weboptimizer clear",
    "document": "weboptimizer document",
    "lint": "weboptimizer lint",
    "prepare": "yarn build",
    "serve": "yarn build:plain && yarn start",
    "serve:headers": "ln --force --symbolic examples/headers.json configuration.json && yarn serve",
    "serve:random": "ln --force --symbolic examples/random.json configuration.json && yarn serve",
    "serve:simple": "ln --force --symbolic examples/simple.json configuration.json && yarn serve",
    "serve:state-apis": "ln --force --symbolic examples/state-apis.json configuration.json && yarn serve",
    "start": "./dist/index.js",
    "test": "weboptimizer test",
    "test:coverage": "weboptimizer test:coverage",
    "test:coverage:report": "weboptimizer test:coverage:report",
    "update:documentation": "web-documentation",
    "watch": "weboptimizer build --watch"
  },
  "dependencies": {
    "clientnode": "^4.0.1533",
    "core-js": "^3.51.0"
  },
  "devDependencies": {
    "@babel/cli": "^8.1.0",
    "@babel/core": "^8.1.3",
    "@babel/eslint-parser": "^8.1.2",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/node": "^26.6.11",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "eslint": "^10.15.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-jsdoc": "^65.5.6",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jsdoc": "^4.0.5",
    "typescript-eslint": "^8.74.0",
    "web-documentation": "^2.0.0",
    "weboptimizer": "^4.0.126"
  },
  "resolutions": {
    "colors": "1.4.0"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=12",
    "yarn": ">=4"
  },
  "configuration": {
    "forwarders": {
      "base": {
        "headerTransformations": {
          "retrieve": [],
          "send": []
        },
        "host": "localhost",
        "port": 443,
        "rejectUnauthorized": false,
        "stateAPIs": [
          {
            "data": {},
            "expressions": {
              "post": "true",
              "pre": "false"
            },
            "name": "base",
            "options": {},
            "url": ""
          }
        ],
        "tls": true,
        "useExpression": "true"
      }
    },
    "host": "",
    "logLevel": "info",
    "nodeServerOptions": {},
    "parseBody": false,
    "port": {
      "__evaluate__": "parseInt(environment.PORT ?? '8080')"
    },
    "privateKeyPath": "",
    "publicKeyPath": ""
  },
  "webDocumentation": {
    "languages": [
      "enUS",
      "deDE",
      "frFR"
    ]
  },
  "webOptimizer": {
    "assetPattern": {
      "javaScript": {
        "includeFilePathRegularExpression": "^(.+/)?index\\.js$",
        "pattern": {
          "#": "This is how we can make our main exported artifact executable.",
          "__evaluate__": "`#!/usr/bin/env node\n// -*- coding: utf-8 -*-\n${self.generic.assetPattern?.javaScript?.pattern ?? ''}\n{1}`"
        }
      }
    },
    "module": {
      "optimizer": {
        "javaScript": {
          "minify": {
            "options": {
              "compress": {
                "#": "To provide a logging output we need to exclude this feature.",
                "drop_console": {
                  "__evaluate__": "false"
                },
                "drop_debugger": {
                  "__evaluate__": "false"
                }
              }
            }
          }
        }
      }
    },
    "path": {
      "source": {
        "base": "src/"
      },
      "target": {
        "base": "dist/"
      }
    },
    "targetTechnology": {
      "boilerplate": "node",
      "payload": "node"
    },
    "webpack": {
      "module": {
        "parser": {
          "javascript": {
            "importMeta": {
              "#": "NOTE: We want to have this preserved by webpack to get the runtime value for \"import.meta.main\".",
              "main": false
            }
          }
        }
      }
    }
  },
  "packageManager": "yarn@4.19.0+sha512.2cb9e5a36f7f11f2bc6ff444830d87368d419e0d83b6a0fb6077d3e6fed0f476c9514dff4ba4d84b049bd34ef32954e550f264ad2fbbfebcba6c89e869530bba"
}
