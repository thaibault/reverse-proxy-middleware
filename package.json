{
  "name": "reverse-proxy-middleware",
  "version": "0.0.146",
  "description": "A reverse proxy blocking bot requests.",
  "keywords": [
    "api",
    "backend",
    "bot-blocker",
    "middleware",
    "proxy",
    "reverse-proxy",
    "web"
  ],
  "homepage": "https://tsickert.com/reverse-proxy-middleware",
  "bugs": {
    "email": "info@tsickert.com",
    "url": "https://github.com/thaibault/reverse-proxy-middleware/issues"
  },
  "license": "CC-BY-4.0",
  "author": {
    "email": "info@tsickert.com",
    "name": "Torben Sickert",
    "url": "https://tsickert.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thaibault/reverse-proxy-middleware.git"
  },
  "type": "module",
  "imports": {
    "*": "/application/node_modules/*"
  },
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "yarn build:types && yarn build:plain",
    "build:plain": "weboptimizer build",
    "build:types": "weboptimizer build:types",
    "check": "yarn check:types && yarn lint",
    "check:types": "weboptimizer check:types",
    "clear": "weboptimizer clear",
    "document": "weboptimizer document",
    "lint": "weboptimizer lint",
    "prepare": "yarn build",
    "serve": "yarn build:plain && yarn start",
    "serve:custom": "ln --force --symbolic examples/custom.json configuration.json && yarn serve",
    "serve:headers": "ln --force --symbolic examples/headers.json configuration.json && yarn serve",
    "serve:random": "ln --force --symbolic examples/random.json configuration.json && yarn serve",
    "serve:simple": "ln --force --symbolic examples/simple.json configuration.json && yarn serve",
    "serve:state-apis": "ln --force --symbolic examples/state-apis.json configuration.json && yarn serve",
    "start": "./dist/index.js",
    "test": "weboptimizer test",
    "test:coverage": "weboptimizer test:coverage",
    "test:coverage:report": "weboptimizer test:coverage:report",
    "update:documentation": "web-documentation",
    "watch": "weboptimizer build --watch"
  },
  "dependencies": {
    "clientnode": "^4.0.1530"
  },
  "devDependencies": {
    "@babel/cli": "^8.1.0",
    "@babel/eslint-parser": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.6",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-jsdoc": "^65.4.2",
    "jest": "^30.5.2",
    "jsdoc": "^4.0.5",
    "typescript-eslint": "^8.72.1",
    "web-documentation": "^1.0.72",
    "weboptimizer": "^4.0.109"
  },
  "resolutions": {
    "colors": "1.4.0",
    "globals@npm:^11.1.0": "patch:globals@npm%3A11.12.0#~/.yarn/patches/globals-npm-11.12.0-1fa7f41a6c.patch",
    "globals@npm:^14.0.0": "patch:globals@npm%3A11.12.0#~/.yarn/patches/globals-npm-11.12.0-1fa7f41a6c.patch",
    "globals@npm:^9.18.0": "patch:globals@npm%3A11.12.0#~/.yarn/patches/globals-npm-11.12.0-1fa7f41a6c.patch"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=12",
    "yarn": ">=4"
  },
  "configuration": {
    "forwarders": {
      "base": {
        "headerTransformations": {
          "retrieve": [],
          "send": []
        },
        "host": "localhost",
        "port": 443,
        "stateAPIs": [
          {
            "data": {},
            "expressions": {
              "post": "true",
              "pre": "false"
            },
            "name": "base",
            "options": {},
            "url": ""
          }
        ],
        "tls": true,
        "useExpression": "true"
      }
    },
    "host": "localhost",
    "nodeServerOptions": {
      "allowHTTP1": true
    },
    "parseBody": false,
    "port": 8080,
    "privateKeyPath": "",
    "publicKeyPath": ""
  },
  "webDocumentation": {
    "languages": [
      "enUS",
      "deDE",
      "frFR"
    ]
  },
  "webOptimizer": {
    "assetPattern": {
      "javaScript": {
        "includeFilePathRegularExpression": "^(.+/)?index\\.js$",
        "pattern": {
          "#": "This is how we can make our main exported artifact executable.",
          "__evaluate__": "`#!/usr/bin/env node\n// -*- coding: utf-8 -*-\n${self.generic.assetPattern?.javaScript?.pattern ?? ''}\n{1}`"
        }
      }
    },
    "module": {
      "optimizer": {
        "terser": {
          "terserOptions": {
            "compress": {
              "#": "To provide a logging output we need to exclude this feature.",
              "drop_console": {
                "__evaluate__": "false"
              },
              "drop_debugger": {
                "__evaluate__": "false"
              }
            }
          }
        }
      }
    },
    "path": {
      "source": {
        "base": "src/"
      },
      "target": {
        "base": "dist/"
      }
    },
    "targetTechnology": {
      "boilerplate": "node",
      "payload": "node"
    },
    "webpack": {
      "module": {
        "parser": {
          "javascript": {
            "importMeta": {
              "#": "NOTE: We want to have this preserved by webpack to get the runtime value for \"import.meta.main\".",
              "main": false
            }
          }
        }
      }
    }
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
}
