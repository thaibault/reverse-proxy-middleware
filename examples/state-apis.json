{
  "forwarders": {
    "bing": {
      "host": "www.bing.com",

      "stateAPIs": {
        "data": {
          "question": "What is the meaning of life?"
        },
        "expressions": {
          "pre": "request.headers['ask-for-sense-of-life'] ? true : null",
          "post": "stateAPI.response?.ok ? null : stateAPI.response?.status ?? 502"
        },
        "name": "sense",
        "urlExpression": "`https://www.google.com/search?q=${encodeURIComponent(data.question)}`"
      }
    }
  }
}
